---
import Layout from '../../layouts/Layout.astro';
import { tarunam, friendlyError, formatTime, formatDay } from '../../lib/tarunam.js';

const user = Astro.locals.user;
const tenant = Astro.locals.tenant;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const DATE = /^\d{4}-\d{2}-\d{2}$/;
const tz = tenant.timeZone || 'Asia/Kolkata';

// Date helpers. Days are "YYYY-MM-DD" keys in the studio's time zone, so no zone can shift a day.
const keyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: tz });
const keyOf = (iso) => keyFmt.format(new Date(iso));
const addDays = (key, n) => {
  const [y, m, d] = key.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d + n)).toISOString().slice(0, 10);
};
const utcFmt = (options) => new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', ...options });
const longFmt = utcFmt({ weekday: 'long', day: 'numeric', month: 'long' });
const shortFmt = utcFmt({ weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
const weekdayFmt = utcFmt({ weekday: 'short' });
const monthFmt = utcFmt({ month: 'short' });
const labelOf = (key, formatter) => formatter.format(new Date(`${key}T00:00:00Z`));

const ICONS = [
  [/yoga|vinyasa|flow|stretch|mobility|meditat|sound bath/i, '🧘'],
  [/pilates|barre/i, '🤸'],
  [/hiit|cardio|circuit|bootcamp|conditioning/i, '🔥'],
  [/spin|cycl|bike/i, '🚴'],
  [/box|kick|mma|martial/i, '🥊'],
  [/strength|weight|lift|power|crossfit|heavy/i, '🏋️'],
  [/swim|aqua/i, '🏊'],
  [/danc|zumba/i, '💃'],
  [/run|treadmill/i, '🏃'],
];

function classLook(name) {
  const text = String(name ?? '');
  const match = ICONS.find(([pattern]) => pattern.test(text));
  let hash = 0;
  for (const ch of text) hash = (hash * 31 + ch.codePointAt(0)) >>> 0;
  return { icon: match ? match[1] : '✨', hue: hash % 360 };
}

const hourFmt = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' });
const partOf = (iso) => {
  const hour = Number(hourFmt.format(new Date(iso)));
  return hour < 12 ? 'Morning' : hour < 17 ? 'Afternoon' : 'Evening';
};
const PART_ICON = { Morning: '🌅', Afternoon: '☀️', Evening: '🌙' };
const minutesBetween = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 60000);

const params = Astro.url.searchParams;
const resourceParam = params.get('resource') ?? '';
const resourceId = UUID.test(resourceParam) ? resourceParam : '';
const todayKey = keyOf(new Date().toISOString());

let allSessions = [];
let resources = [];
let settings = null;
let horizonDays = 14;
let error = '';

try {
  const [r, st] = await Promise.all([
    tarunam('GET', '/resources', { tenant }),
    tarunam('GET', '/settings', { tenant }),
  ]);

  if (r.status === 200) resources = r.data;
  if (st.status === 200) settings = st.data;

  const minutes = settings?.max_horizon_minutes;
  if (minutes) horizonDays = Math.min(Math.max(Math.ceil(minutes / 1440), 1), 30);

  const from = new Date();
  const to = new Date(from.getTime() + (horizonDays + 2) * 24 * 3600 * 1000);

  const s = await tarunam('GET', '/schedules', {
    tenant,
    query: { from: from.toISOString(), to: to.toISOString(), limit: 500 },
  });

  if (s.status !== 200) error = friendlyError(s).message;
  else allSessions = s.data;
} catch (err) {
  console.error('[ui] could not reach the booking service:', err.message);
  error = 'The booking service is unavailable right now. Please try again in a moment.';
}

const minKey = todayKey;
const maxKey = addDays(todayKey, horizonDays);

const sessions = resourceId ? allSessions.filter((s) => s.resource_id === resourceId) : allSessions;
const withSessions = [...new Set(sessions.map((s) => keyOf(s.start_time)))]
  .filter((k) => k >= minKey && k <= maxKey)
  .sort();
const hasSet = new Set(withSessions);

// How many sessions each day has (for the week strip)
const dayCount = new Map();
for (const s of sessions) {
  const k = keyOf(s.start_time);
  dayCount.set(k, (dayCount.get(k) ?? 0) + 1);
}

const requested = params.get('date') ?? '';
const validRequested = DATE.test(requested) && requested >= minKey && requested <= maxKey;
const selected = validRequested ? requested : (withSessions[0] ?? todayKey);

const daySessions = sessions.filter((s) => keyOf(s.start_time) === selected);
const dayLabel = daySessions.length > 0 ? formatDay(daySessions[0].start_time) : labelOf(selected, longFmt);
const nextAvailable = withSessions.find((k) => k > selected) ?? null;
const relative = selected === todayKey ? 'Today' : selected === addDays(todayKey, 1) ? 'Tomorrow' : '';
const seatsOpen = daySessions.reduce((sum, s) => sum + s.seats_left, 0);
const stripDays = Array.from({ length: horizonDays + 1 }, (_, i) => addDays(minKey, i));

// ---- "Next up": the first session a visitor could actually book right now (any class) ----
const nowMs = Date.now();
const leadMs = (settings?.min_lead_minutes ?? 0) * 60000;
const nextUp =
  allSessions
    .filter((s) => s.seats_left > 0 && Date.parse(s.start_time) > nowMs + leadMs && keyOf(s.start_time) <= maxKey)
    .sort((a, b) => Date.parse(a.start_time) - Date.parse(b.start_time))[0] ?? null;
const nextDayKey = nextUp ? keyOf(nextUp.start_time) : null;
const nextWhen = nextUp
  ? nextDayKey === todayKey ? 'Today' : nextDayKey === addDays(todayKey, 1) ? 'Tomorrow' : formatDay(nextUp.start_time)
  : '';
const minsToNext = nextUp ? Math.round((Date.parse(nextUp.start_time) - nowMs) / 60000) : 0;
const nextIn = !nextUp ? '' : minsToNext < 60 ? `in ${Math.max(minsToNext, 1)} min` : minsToNext < 1440 ? `in ${Math.round(minsToNext / 60)} h` : '';
const nextLook = nextUp ? classLook(nextUp.resource_name) : null;

let counter = 0;
const parts = ['Morning', 'Afternoon', 'Evening']
  .map((name) => ({
    name,
    icon: PART_ICON[name],
    items: daySessions.filter((s) => partOf(s.start_time) === name).map((s) => ({ s, n: counter++ })),
  }))
  .filter((p) => p.items.length > 0);

// "open" makes the page open the booking dialog for that session on load (used by the Next up card)
function link({ date = selected, resource = resourceId, open = '' } = {}) {
  const query = new URLSearchParams({ date });
  if (resource) query.set('resource', resource);
  if (open) query.set('open', open);
  return `/${tenant.slug}?${query}`;
}

const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
const rules = [];
if (settings?.min_lead_minutes != null) rules.push(`Booking closes ${settings.min_lead_minutes} min before the start`);
if (settings?.min_cancel_notice_minutes) rules.push(`Cancel up to ${settings.min_cancel_notice_minutes} min before the start`);
---

<Layout title="Sessions">

  <!-- Studio hero -->
  <section class:list={['th-hero', { 'th-hero--solo': !nextUp || !!error }]}>
    <div class="th-hero-main">
      <p class="th-eyebrow">Book a session</p>
      <h1>{tenant.name}</h1>
      <p class="th-sub">Choose a date, pick a class and reserve your spot.</p>

      {!error && (
        <div class="th-stats">
          <div class="th-stat">
            <span class="th-stat-icon" aria-hidden="true">📅</span>
            <b>{daySessions.length}</b>
            <span>{daySessions.length === 1 ? 'Session' : 'Sessions'} {selected === todayKey ? 'today' : 'on this day'}</span>
          </div>
          <div class="th-stat">
            <span class="th-stat-icon" aria-hidden="true">🎟️</span>
            <b>{seatsOpen}</b>
            <span>{seatsOpen === 1 ? 'Seat' : 'Seats'} open</span>
          </div>
          <div class="th-stat">
            <span class="th-stat-icon" aria-hidden="true">✨</span>
            <b>{resources.length}</b>
            <span>{resources.length === 1 ? 'Class' : 'Classes'} offered</span>
          </div>
        </div>
      )}
    </div>

    {nextUp && !error && (
      <a class="th-next" href={link({ date: nextDayKey, resource: '', open: nextUp.id })} aria-label={`Book ${nextUp.resource_name}, ${nextWhen} at ${formatTime(nextUp.start_time)}`}>
        <span class="th-next-label">Next up</span>
        <span class="th-next-body">
          <span class="th-next-icon" aria-hidden="true">{nextLook.icon}</span>
          <span class="th-next-text">
            <strong>{nextUp.resource_name}</strong>
            <span>{nextWhen} · {formatTime(nextUp.start_time)}{nextIn ? ` · ${nextIn}` : ''}</span>
            <span class="th-next-seats">{nextUp.seats_left} {nextUp.seats_left === 1 ? 'seat' : 'seats'} left</span>
          </span>
        </span>
        <span class="th-next-cta">Book now →</span>
      </a>
    )}
  </section>

  <!-- Week strip, calendar dropdown and class filter (sticky on wide screens) -->
  <section class="schedule-panel" id="schedule">
    <nav class="week" id="week" aria-label="Choose a day">
      {stripDays.map((k) => (
        <a
          class:list={['wd', { 'is-selected': k === selected, 'is-today': k === todayKey, has: hasSet.has(k) }]}
          href={link({ date: k })}
          aria-current={k === selected ? 'date' : undefined}
          aria-label={`${labelOf(k, longFmt)}${hasSet.has(k) ? `, ${dayCount.get(k)} ${dayCount.get(k) === 1 ? 'session' : 'sessions'}` : ', no sessions'}`}
        >
          <small>{k === todayKey ? 'Today' : labelOf(k, weekdayFmt)}</small>
          <b>{Number(k.slice(8))}</b>
          <em>{labelOf(k, monthFmt)}</em>
        </a>
      ))}
    </nav>

    <div class="sched-row">
      <div class="datebar">
        <div
          class="dp-wrap"
          id="datepicker"
          data-slug={tenant.slug}
          data-min={minKey}
          data-max={maxKey}
          data-selected={selected}
          data-today={todayKey}
          data-resource={resourceId}
          data-days={JSON.stringify(withSessions)}
        >
          <button type="button" class="dp-trigger" data-dp-trigger aria-haspopup="dialog" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            <span>{labelOf(selected, shortFmt)}</span>
            <span class="dp-chev" aria-hidden="true">▾</span>
          </button>

          <div class="dp-panel" data-dp-panel hidden role="dialog" aria-label="Choose a date">
            <div class="dp-head">
              <button type="button" class="dp-nav" data-dp-prev aria-label="Previous month">‹</button>
              <strong data-dp-title></strong>
              <button type="button" class="dp-nav" data-dp-next aria-label="Next month">›</button>
            </div>
            <div class="dp-weekdays">
              <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span><span>Su</span>
            </div>
            <div class="dp-grid" data-dp-grid></div>
            <div class="dp-legend"><i></i> Sessions available</div>
          </div>
        </div>

        {selected !== todayKey && (
          <a class="btn btn-sm btn-ghost" href={link({ date: todayKey })}>Today</a>
        )}
      </div>

      <div class="chips" aria-label="Class">
        <a class:list={['chip', { active: !resourceId }]} href={link({ resource: '' })}>All classes</a>
        {resources.map((r) => (
          <a class:list={['chip', { active: r.id === resourceId }]} href={link({ resource: r.id })}>
            {classLook(r.name).icon} {r.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  {rules.length > 0 && (
    <p class="rules-line">
      {rules.map((r) => <span>ⓘ {r}</span>)}
    </p>
  )}

  {error && <p class="alert" role="alert">{error}</p>}

  {!error && daySessions.length === 0 && (
    <div class="empty">
      <div class="empty-icon">🗓️</div>
      <h2>No sessions available</h2>
      <p>No sessions on {labelOf(selected, longFmt)}{resourceId ? ' for this class' : ''}.</p>
      {nextAvailable
        ? <p><a class="btn btn-sm" href={link({ date: nextAvailable })}>Next available: {labelOf(nextAvailable, shortFmt)} →</a></p>
        : <p>Nothing is scheduled in the booking window yet.</p>}
    </div>
  )}

  {daySessions.length > 0 && (
    <div class="sx-dayhead">
      <div>
        <p class="section-kicker">YOUR DAILY LINEUP</p>
        <h2>{dayLabel} {relative && <span class="dp-pill">{relative}</span>}</h2>
      </div>
      <span class="day-total">{daySessions.length} {daySessions.length === 1 ? 'session' : 'sessions'}</span>
    </div>
  )}

  {parts.map((part) => (
    <section class="sx-group">
      <h3 class="sx-part">
        <span class="part-icon" aria-hidden="true">{part.icon}</span>
        {part.name}
        <span class="sx-count">· {part.items.length}</span>
      </h3>

      <ul class="sessions">
        {part.items.map(({ s, n }) => {
          const look = classLook(s.resource_name);
          const pct = Math.round(((s.capacity - s.seats_left) / s.capacity) * 100);
          const low = s.seats_left > 0 && s.seats_left <= 3;
          const full = s.seats_left === 0;
          const fast = pct >= 70 && !low && !full;
          const startsInMin = (Date.parse(s.start_time) - Date.now()) / 60000;
          const soon = startsInMin > 0 && startsInMin <= 120;

          return (
            <li class="session sx" style={`--hue:${look.hue};--i:${n}`} data-capacity={s.capacity}>
              <div class="sx-icon" aria-hidden="true">{look.icon}</div>

              <div class="sx-main">
                <div class="sx-title">
                  <strong>{s.resource_name}</strong>
                  {soon && <span class="sx-tag sx-soon">Starting soon</span>}
                  <span class="sx-tag sx-fast" data-fast hidden={!fast}>Filling fast</span>
                  <span class="sx-tag sx-hot" data-low hidden={!low}>Only {s.seats_left} left</span>
                </div>

                <div class="sx-meta">
                  <span>◷ {formatTime(s.start_time)} – {formatTime(s.end_time)}</span>
                  <span class="meta-dot">·</span>
                  <span>{minutesBetween(s.start_time, s.end_time)} min</span>
                </div>

                <div class:list={['sx-meter', { low, full }]} data-meter>
                  <i style={`width:${pct}%`}></i>
                </div>

                <span class="seats" data-seats-label>
                  {full ? 'Fully booked' : `${s.seats_left} of ${s.capacity} seats left`}
                </span>
              </div>

              {user ? (
                <button
                  class="btn btn-sm sx-book"
                  type="button"
                  data-book
                  data-id={s.id}
                  data-name={s.resource_name}
                  data-when={`${dayLabel}, ${formatTime(s.start_time)}`}
                  data-start={s.start_time}
                  data-end={s.end_time}
                  data-seats={s.seats_left}
                  disabled={full}
                >
                  {full ? 'Full' : 'Book now'} <span aria-hidden="true">→</span>
                </button>
              ) : (
                <a class="btn btn-sm btn-ghost sx-book" href={loginHref}>Sign in to book →</a>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  {user && (
    <dialog id="book-dialog" data-tenant={tenant.slug} data-studio={tenant.name} aria-labelledby="bd-title">
      <div class="dialog-body">
        <div class="dialog-icon">🎟️</div>
        <p class="section-kicker">RESERVE YOUR SPOT</p>
        <h2 id="bd-title">Confirm booking</h2>
        <p class="dialog-session">
          <strong id="bd-name"></strong><br />
          <span id="bd-when" class="muted"></span>
        </p>
        <label for="bd-guests">Number of guests</label>
        <select id="bd-guests" class="input"></select>
        <p id="bd-msg" class="msg" role="status" aria-live="polite"></p>
        <p id="bd-done" class="bd-done" hidden>
          <a class="link" href={`/${tenant.slug}/bookings`}>View my bookings →</a>
          <button type="button" class="btn btn-sm btn-ghost" id="bd-ics">📅 Add to calendar</button>
        </p>
        <div class="dialog-actions">
          <button type="button" class="btn btn-ghost" id="bd-close">Close</button>
          <button type="button" class="btn" id="bd-confirm">Confirm booking</button>
        </div>
      </div>
    </dialog>
  )}
</Layout>

<!-- Booking script: your working version, plus one guarded toast line -->
<script is:inline>
  const dialog = document.getElementById('book-dialog');

  if (dialog) {
    const tenantSlug = dialog.dataset.tenant;
    const $ = (id) => document.getElementById(id);
    const msg = $('bd-msg');
    const guests = $('bd-guests');
    const confirmBtn = $('bd-confirm');
    const done = $('bd-done');
    let current = null;

    function setMsg(text, kind) {
      msg.textContent = text;
      msg.className = 'msg ' + (kind || '');
    }

    function updateCard(card, left) {
      const label = card.querySelector('[data-seats-label]');
      const button = card.querySelector('[data-book]');

      label.textContent = left === 0 ? 'Fully booked' : left + ' of ' + card.dataset.capacity + ' seats left';
      button.dataset.seats = String(left);
      button.disabled = left === 0;
      button.textContent = left === 0 ? 'Full' : 'Book now →';
    }

    document.addEventListener('click', (e) => {
      const button = e.target.closest('[data-book]');
      if (!button || button.disabled) return;

      current = { id: button.dataset.id, name: button.dataset.name, when: button.dataset.when, card: button.closest('.session'), nonce: crypto.randomUUID() };

      $('bd-name').textContent = button.dataset.name;
      $('bd-when').textContent = button.dataset.when;

      guests.innerHTML = '';

      const max = Math.min(Number(button.dataset.seats), 6);

      for (let n = 1; n <= max; n++) {
        const option = document.createElement('option');
        option.value = String(n);
        option.textContent = n === 1 ? '1 guest' : n + ' guests';
        guests.append(option);
      }

      setMsg('');
      done.hidden = true;
      confirmBtn.hidden = false;
      confirmBtn.disabled = false;
      dialog.showModal();
    });

    $('bd-close').addEventListener('click', () => dialog.close());

    confirmBtn.addEventListener('click', async () => {
      if (!current) return;

      confirmBtn.disabled = true;
      setMsg('Booking…');

      try {
        const res = await fetch(`/api/${tenantSlug}/book`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            schedule_id: current.id,
            guests: Number(guests.value),
            nonce: current.nonce,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok) {
          setMsg('You are booked!', 'ok');
          if (window.toast) window.toast('Booked: ' + current.name + ' · ' + current.when, 'ok');
          done.hidden = false;
          confirmBtn.hidden = true;

          if (typeof data.seats_left === 'number') {
            updateCard(current.card, data.seats_left);
          }
        } else {
          setMsg(data.message || 'Something went wrong.', 'err');
          confirmBtn.disabled = false;
        }
      } catch {
        setMsg('Network problem. Press Confirm again. It is safe to retry and will not book twice.', 'err');
        confirmBtn.disabled = false;
      }
    });
  }
</script>

<!-- Calendar dropdown script (unchanged) -->
<script is:inline>
  (function () {
    var root = document.getElementById('datepicker');
    if (!root) return;

    var slug = root.dataset.slug;
    var min = root.dataset.min;
    var max = root.dataset.max;
    var selected = root.dataset.selected;
    var today = root.dataset.today;
    var resource = root.dataset.resource;
    var withSessions = new Set(JSON.parse(root.dataset.days || '[]'));

    var trigger = root.querySelector('[data-dp-trigger]');
    var panel = root.querySelector('[data-dp-panel]');
    var title = root.querySelector('[data-dp-title]');
    var grid = root.querySelector('[data-dp-grid]');
    var prev = root.querySelector('[data-dp-prev]');
    var next = root.querySelector('[data-dp-next]');

    var MONTHS = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December',
    ];

    function pad(n) {
      return String(n).padStart(2, '0');
    }

    function keyOf(y, m, d) {
      return y + '-' + pad(m + 1) + '-' + pad(d);
    }

    function parse(k) {
      var p = k.split('-').map(Number);
      return { y: p[0], m: p[1] - 1, d: p[2] };
    }

    var view = parse(selected);

    function go(dateKey) {
      var q = new URLSearchParams({ date: dateKey });
      if (resource) q.set('resource', resource);
      location.href = '/' + slug + '?' + q.toString();
    }

    function close() {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }

    function render() {
      title.textContent = MONTHS[view.m] + ' ' + view.y;
      grid.innerHTML = '';

      var offset = (new Date(Date.UTC(view.y, view.m, 1)).getUTCDay() + 6) % 7;
      var days = new Date(Date.UTC(view.y, view.m + 1, 0)).getUTCDate();

      for (var i = 0; i < offset; i++) {
        grid.append(document.createElement('span'));
      }

      for (var d = 1; d <= days; d++) {
        (function (day) {
          var k = keyOf(view.y, view.m, day);
          var button = document.createElement('button');

          button.type = 'button';
          button.className = 'dp-day';
          button.textContent = String(day);
          button.disabled = k < min || k > max;

          if (k === today) button.classList.add('is-today');
          if (k === selected) button.classList.add('is-selected');
          if (withSessions.has(k)) button.classList.add('has-sessions');

          button.setAttribute(
            'aria-label',
            day + ' ' + MONTHS[view.m] + ' ' + view.y +
            (withSessions.has(k) ? ', sessions available' : '')
          );

          button.addEventListener('click', function () {
            go(k);
          });

          grid.append(button);
        })(d);
      }

      var lo = parse(min);
      var hi = parse(max);

      prev.disabled = view.y * 12 + view.m <= lo.y * 12 + lo.m;
      next.disabled = view.y * 12 + view.m >= hi.y * 12 + hi.m;
    }

    trigger.addEventListener('click', function () {
      var opening = panel.hidden;
      panel.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));

      if (opening) {
        view = parse(selected);
        render();
      }
    });

    prev.addEventListener('click', function () {
      view.m -= 1;
      if (view.m < 0) {
        view.m = 11;
        view.y -= 1;
      }
      render();
    });

    next.addEventListener('click', function () {
      view.m += 1;
      if (view.m > 11) {
        view.m = 0;
        view.y += 1;
      }
      render();
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });
  })();
</script>

<!-- Seat meter, "Only N left" and "Filling fast" tags stay in step with the booking script -->
<script is:inline>
  (function () {
    var cards = document.querySelectorAll('.session.sx');

    if (!cards.length || !('MutationObserver' in window)) return;

    cards.forEach(function (card) {
      var button = card.querySelector('[data-book]');
      if (!button) return;

      new MutationObserver(function () {
        var cap = Number(card.dataset.capacity);
        var left = Number(button.dataset.seats);
        var pct = Math.round(((cap - left) / cap) * 100);
        var meter = card.querySelector('[data-meter]');
        var low = card.querySelector('[data-low]');
        var fast = card.querySelector('[data-fast]');
        var isLow = left > 0 && left <= 3;

        meter.firstElementChild.style.width = pct + '%';
        meter.classList.toggle('full', left === 0);
        meter.classList.toggle('low', isLow);

        low.hidden = !isLow;
        low.textContent = 'Only ' + left + ' left';
        if (fast) fast.hidden = !(pct >= 70 && left > 3);
      }).observe(button, {
        attributes: true,
        attributeFilter: ['data-seats'],
      });
    });
  })();
</script>

<!-- Week strip: centre the chosen day -->
<script is:inline>
  (function () {
    var week = document.getElementById('week');
    var chosen = week && week.querySelector('.is-selected');
    if (week && chosen) week.scrollLeft = chosen.offsetLeft - (week.clientWidth - chosen.clientWidth) / 2;
  })();
</script>

<!-- "Add to calendar": downloads an .ics file for the session just booked -->
<script is:inline>
  (function () {
    var dialog = document.getElementById('book-dialog');
    if (!dialog) return;
    var session = null;

    // Remember which session the dialog was opened for
    document.addEventListener('click', function (e) {
      var button = e.target.closest('[data-book]');
      if (button && !button.disabled) {
        session = { id: button.dataset.id, name: button.dataset.name, start: button.dataset.start, end: button.dataset.end };
      }
    });

    function stamp(iso) {
      return new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    }
    function esc(value) {
      return String(value).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
    }

    var icsBtn = document.getElementById('bd-ics');
    if (!icsBtn) return;
    icsBtn.addEventListener('click', function () {
      if (!session || !session.start || !session.end) return;
      var guestSelect = document.getElementById('bd-guests');
      var count = guestSelect ? Number(guestSelect.value) || 1 : 1;
      var studio = dialog.dataset.studio || 'Studio';
      var lines = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Tarunam Studios//Booking//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'BEGIN:VEVENT',
        'UID:' + session.id + '-' + Date.now() + '@tarunam-studios',
        'DTSTAMP:' + stamp(new Date().toISOString()),
        'DTSTART:' + stamp(session.start),
        'DTEND:' + stamp(session.end),
        'SUMMARY:' + esc(session.name + ' at ' + studio),
        'DESCRIPTION:' + esc('Booked for ' + count + (count === 1 ? ' guest' : ' guests') + ' via Tarunam Studios.'),
        'LOCATION:' + esc(studio),
        'END:VEVENT',
        'END:VCALENDAR',
      ];
      var blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = (session.name || 'session').replace(/[^a-z0-9]+/gi, '-').toLowerCase() + '.ics';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    });
  })();
</script>

<!-- "Next up" card: opens the booking dialog for the session named in ?open= -->
<script is:inline>
  (function () {
    var id = new URLSearchParams(location.search).get('open');
    if (!id) return;
    var button = document.querySelector('[data-book][data-id="' + CSS.escape(id) + '"]');
    if (button && !button.disabled) button.click();
    var url = new URL(location.href);
    url.searchParams.delete('open'); // so a refresh does not reopen the dialog
    history.replaceState(null, '', url.pathname + url.search);
  })();
</script>

