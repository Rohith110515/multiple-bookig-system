---
import Layout from '../../layouts/Layout.astro';
import QRCode from 'qrcode';
import { tarunam, friendlyError, formatTime } from '../../lib/tarunam.js';

const user = Astro.locals.user;
const tenant = Astro.locals.tenant;
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(`/${tenant.slug}/bookings`)}`);

const tz = tenant.timeZone || 'Asia/Kolkata';
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

let bookings = [];
let error = '';
try {
  const res = await tarunam('GET', '/bookings', {
    tenant,
    userId: user.id,
    query: { user_id: user.id, order: 'asc', limit: 200 },
  });
  if (res.status === 200) bookings = res.data;
  else error = friendlyError(res).message;
} catch (err) {
  console.error('[ui] could not reach the booking service:', err.message);
  error = 'The booking service is unavailable right now. Please try again in a moment.';
}

const now = Date.now();
const upcoming = bookings.filter((b) => b.status === 'confirmed' && Date.parse(b.start_time) > now);
const earlier = bookings.filter((b) => !upcoming.includes(b)).reverse(); // newest first

const stats = {
  upcoming: upcoming.length,
  attended: bookings.filter((b) => b.status === 'completed').length,
  cancelled: bookings.filter((b) => b.status === 'cancelled').length,
  noShow: bookings.filter((b) => b.status === 'no_show').length,
};

const LABELS = { confirmed: 'Confirmed', cancelled: 'Cancelled', completed: 'Attended', no_show: 'No-show' };

// ---- Tickets: one QR code (SVG) per upcoming booking, built on the server ----
// The code holds only the studio and the booking reference. Nothing personal goes into it.
const qr = {};
await Promise.all(
  upcoming.map(async (b) => {
    if (!UUID.test(b.id)) return;
    try {
      qr[b.id] = await QRCode.toString(`tarunam:${tenant.slug}:${b.id}`, {
        type: 'svg',
        margin: 1,
        errorCorrectionLevel: 'M',
        color: { dark: '#0f172a', light: '#ffffff' },
      });
    } catch (err) {
      console.error('[ui] could not build a QR code:', err.message);
    }
  }),
);
const ticketCode = (id) => String(id).slice(0, 8).toUpperCase();
const dayLongFmt = new Intl.DateTimeFormat('en-IN', { timeZone: tz, weekday: 'long', day: 'numeric', month: 'long' });

// ---- Presentation helpers (same icons and colours as the sessions page) ----
const ICONS = [
  [/yoga|vinyasa|flow|stretch|mobility|meditat|sound bath/i, '🧘'],
  [/pilates|barre/i, '🤸'],
  [/hiit|cardio|circuit|bootcamp|conditioning/i, '🔥'],
  [/spin|cycl|bike/i, '🚴'],
  [/box|kick|mma|martial/i, '🥊'],
  [/strength|weight|lift|power|crossfit|heavy/i, '🏋️'],
  [/swim|aqua/i, '🏊'],
  [/danc|zumba/i, '💃'],
  [/run|treadmill/i, '🏃'],
];
function classLook(name) {
  const text = String(name ?? '');
  const match = ICONS.find(([pattern]) => pattern.test(text));
  let hash = 0;
  for (const ch of text) hash = (hash * 31 + ch.codePointAt(0)) >>> 0;
  return { icon: match ? match[1] : '✨', hue: hash % 360 };
}

// Month, day number and weekday of a session, in the studio's time zone
const keyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: tz }); // YYYY-MM-DD
const monthFmt = new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', month: 'short' });
const weekdayFmt = new Intl.DateTimeFormat('en-IN', { timeZone: 'UTC', weekday: 'short' });
function badgeOf(iso) {
  const key = keyFmt.format(new Date(iso));
  const date = new Date(`${key}T00:00:00Z`);
  return { month: monthFmt.format(date), day: Number(key.slice(8)), weekday: weekdayFmt.format(date) };
}

const minutesBetween = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 60000);

function countdown(iso) {
  const ms = Date.parse(iso) - Date.now();
  if (ms <= 0) return '';
  const hours = ms / 3600000;
  if (hours < 1) return `in ${Math.max(1, Math.round(ms / 60000))} min`;
  if (hours < 24) return `in ${Math.round(hours)} h`;
  const days = Math.round(hours / 24);
  return `in ${days} ${days === 1 ? 'day' : 'days'}`;
}
---
<Layout title="My bookings">
  <section class="page-head" data-tenant={tenant.slug} data-studio={tenant.name}>
    <h1>My bookings</h1>
    <p class="muted">Signed in as {user.id} at {tenant.name}</p>
    {!error && bookings.length > 0 && (
      <div class="bk-head">
        <div class="bk-stats">
          <span class="bk-chip">{stats.upcoming} upcoming</span>
          <span class="bk-chip">{stats.attended} attended</span>
          <span class="bk-chip">{stats.cancelled} cancelled</span>
          {stats.noShow > 0 && <span class="bk-chip">{stats.noShow} no-show</span>}
        </div>
        {upcoming.length > 1 && (
          <button class="bk-tool bk-all" type="button" data-ics-all>📅 Add all upcoming to calendar</button>
        )}
      </div>
    )}
  </section>

  {error && <p class="alert" role="alert">{error}</p>}

  {!error && bookings.length === 0 && (
    <div class="empty">
      <p>You have no bookings at {tenant.name} yet.</p>
      <p><a class="btn btn-sm" href={`/${tenant.slug}`}>Browse sessions</a></p>
    </div>
  )}

  {upcoming.length > 0 && (
    <section class="day">
      <h2>Upcoming <span class="bk-count">{upcoming.length}</span></h2>
      <ul class="bookings">
        {upcoming.map((b, i) => {
          const look = classLook(b.resource_name);
          const d = badgeOf(b.start_time);
          const when = `${dayLongFmt.format(new Date(b.start_time))} · ${formatTime(b.start_time)} – ${formatTime(b.end_time)}`;
          return (
            <li class="booking bk" style={`--hue:${look.hue};--i:${i}`}>
              <div class="bk-badge"><small>{d.month}</small><b>{d.day}</b><span>{d.weekday}</span></div>
              <div class="bk-main">
                <strong><span aria-hidden="true">{look.icon}</span> {b.resource_name}</strong>
                <span class="bk-meta">
                  {formatTime(b.start_time)} – {formatTime(b.end_time)} · {minutesBetween(b.start_time, b.end_time)} min · {b.guests} {b.guests === 1 ? 'guest' : 'guests'}
                </span>
                {countdown(b.start_time) && <span class="bk-when">{countdown(b.start_time)}</span>}
                <div class="bk-tools">
                  <button
                    class="bk-tool"
                    type="button"
                    data-ics
                    data-id={b.id}
                    data-name={b.resource_name}
                    data-start={b.start_time}
                    data-end={b.end_time}
                    data-guests={b.guests}
                  >📅 Add to calendar</button>
                  {qr[b.id] && (
                    <>
                      <button
                        class="bk-tool"
                        type="button"
                        data-ticket
                        data-id={b.id}
                        data-icon={look.icon}
                        data-name={b.resource_name}
                        data-when={when}
                        data-guests={b.guests}
                        data-code={ticketCode(b.id)}
                      >🎟️ Show ticket</button>
                      <div hidden data-qr-for={b.id} set:html={qr[b.id]}></div>
                    </>
                  )}
                </div>
              </div>
              <div class="actions">
                <span class="badge badge-confirmed">Confirmed</span>
                <button class="btn btn-sm btn-ghost" type="button" data-cancel={b.id}>Cancel</button>
              </div>
              <p class="msg err" data-msg hidden></p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {earlier.length > 0 && (
    <section class="day">
      <h2>Earlier and cancelled</h2>
      <ul class="bookings">
        {earlier.map((b, i) => {
          const look = classLook(b.resource_name);
          const d = badgeOf(b.start_time);
          return (
            <li class="booking bk bk-past" style={`--hue:${look.hue};--i:${i}`}>
              <div class="bk-badge"><small>{d.month}</small><b>{d.day}</b><span>{d.weekday}</span></div>
              <div class="bk-main">
                <strong><span aria-hidden="true">{look.icon}</span> {b.resource_name}</strong>
                <span class="bk-meta">
                  {formatTime(b.start_time)} – {formatTime(b.end_time)} · {b.guests} {b.guests === 1 ? 'guest' : 'guests'}
                </span>
              </div>
              <div class="actions">
                <span class={`badge badge-${b.status}`}>{LABELS[b.status] ?? b.status}</span>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {upcoming.length > 0 && (
    <dialog id="ticket-dialog" aria-labelledby="tk-title">
      <div class="dialog-body tk">
        <p class="tk-kicker">YOUR TICKET</p>
        <div class="tk-head">
          <span class="tk-icon" id="tk-icon" aria-hidden="true"></span>
          <div>
            <h2 id="tk-title"></h2>
            <p class="muted" id="tk-when"></p>
          </div>
        </div>
        <div class="tk-qr" id="tk-qr" role="img" aria-label="Ticket QR code"></div>
        <p class="tk-code">Ticket <b id="tk-code"></b></p>
        <p class="tk-note muted" id="tk-meta"></p>
        <p class="tk-note muted">Show this at the front desk when you arrive.</p>
        <div class="dialog-actions">
          <button type="button" class="btn btn-ghost" id="tk-close">Close</button>
        </div>
      </div>
    </dialog>
  )}
</Layout>

<!-- Cancel script: unchanged from your working version -->
<script is:inline>
  const tenantSlug = document.querySelector('[data-tenant]')?.dataset.tenant;
  document.addEventListener('click', async (e) => {
    const button = e.target.closest('[data-cancel]');
    if (!button || !tenantSlug) return;
    if (!window.confirm('Cancel this booking?')) return;
    const row = button.closest('.booking');
    const msg = row.querySelector('[data-msg]');
    button.disabled = true;
    msg.hidden = true;
    try {
      const res = await fetch(`/api/${tenantSlug}/bookings/${button.dataset.cancel}/cancel`, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (res.ok) {
        location.reload();
        return;
      }
      msg.textContent = data.message || 'Could not cancel this booking.';
    } catch {
      msg.textContent = 'Network problem. Please try again.';
    }
    msg.hidden = false;
    button.disabled = false;
  });
</script>

<!-- Add to calendar: builds an .ics file in the browser (one booking, or all upcoming) -->
<script is:inline>
  (function () {
    var holder = document.querySelector('[data-studio]');
    var studio = (holder && holder.dataset.studio) || 'Studio';

    function stamp(iso) {
      return new Date(iso).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    }
    function esc(value) {
      return String(value).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
    }
    function fromButton(button) {
      return {
        id: button.dataset.id,
        name: button.dataset.name,
        start: button.dataset.start,
        end: button.dataset.end,
        guests: Number(button.dataset.guests) || 1,
      };
    }
    function eventLines(b) {
      return [
        'BEGIN:VEVENT',
        'UID:' + b.id + '@tarunam-studios', // a fixed id, so adding it twice updates the event
        'DTSTAMP:' + stamp(new Date().toISOString()),
        'DTSTART:' + stamp(b.start),
        'DTEND:' + stamp(b.end),
        'SUMMARY:' + esc(b.name + ' at ' + studio),
        'DESCRIPTION:' + esc('Booked for ' + b.guests + (b.guests === 1 ? ' guest' : ' guests') + ' via Tarunam Studios.'),
        'LOCATION:' + esc(studio),
        'STATUS:CONFIRMED',
        'BEGIN:VALARM',
        'ACTION:DISPLAY',
        'DESCRIPTION:' + esc(b.name + ' starts in 1 hour'),
        'TRIGGER:-PT1H',
        'END:VALARM',
        'END:VEVENT',
      ];
    }
    function download(events, filename) {
      var lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Tarunam Studios//Booking//EN', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH'];
      events.forEach(function (event) { lines = lines.concat(eventLines(event)); });
      lines.push('END:VCALENDAR');
      var blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = filename;
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
      if (window.toast) window.toast('Calendar file downloaded', 'ok');
    }
    function slug(text) {
      return String(text).replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').toLowerCase() || 'booking';
    }

    document.addEventListener('click', function (e) {
      var one = e.target.closest('[data-ics]');
      if (one) {
        download([fromButton(one)], slug(one.dataset.name) + '.ics');
        return;
      }
      var all = e.target.closest('[data-ics-all]');
      if (all) {
        var events = Array.prototype.map.call(document.querySelectorAll('[data-ics]'), fromButton);
        if (events.length) download(events, slug(studio) + '-bookings.ics');
      }
    });
  })();
</script>

<!-- Ticket pop-up: copies the server-made QR code into a dialog -->
<script is:inline>
  (function () {
    var dialog = document.getElementById('ticket-dialog');
    if (!dialog) return;
    function $(id) { return document.getElementById(id); }
    var holder = document.querySelector('[data-studio]');
    var studio = (holder && holder.dataset.studio) || '';

    document.addEventListener('click', function (e) {
      var button = e.target.closest('[data-ticket]');
      if (!button) return;
      var source = document.querySelector('[data-qr-for="' + CSS.escape(button.dataset.id) + '"]');
      if (!source) return;

      // Every value goes in through textContent, so nothing can inject HTML
      $('tk-icon').textContent = button.dataset.icon;
      $('tk-title').textContent = button.dataset.name;
      $('tk-when').textContent = button.dataset.when;
      $('tk-code').textContent = button.dataset.code;
      var guests = Number(button.dataset.guests) || 1;
      $('tk-meta').textContent = guests + (guests === 1 ? ' guest' : ' guests') + (studio ? ' · ' + studio : '');

      var target = $('tk-qr');
      target.replaceChildren();
      Array.prototype.forEach.call(source.childNodes, function (node) {
        target.appendChild(node.cloneNode(true));
      });
      dialog.showModal();
    });

    $('tk-close').addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); }); // click on the backdrop
  })();
</script>

<style is:global>
  .bk-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin-top: 0.9rem; }
  .bk-stats { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
  .bk-head .bk-stats { margin-top: 0; }
  .bk-chip { display: inline-block; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.75rem; border-radius: 999px; background: var(--brand-soft, #eef2ff); color: var(--brand-dark, #4338ca); }
  .bk-count { display: inline-block; font-size: 0.78rem; font-weight: 700; padding: 0.05rem 0.6rem; border-radius: 999px; background: var(--brand-soft, #eef2ff); color: var(--brand-dark, #4338ca); vertical-align: middle; margin-left: 0.3rem; }

  .booking.bk {
    --accent: hsl(var(--hue) 70% 50%);
    --tint: hsl(var(--hue) 85% 95%);
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 0.5rem 1.1rem;
    align-items: center;
    padding: 0.9rem 1.2rem 0.9rem 0.9rem;
    border-radius: 16px;
    animation: bk-rise 0.4s ease backwards;
    animation-delay: calc(var(--i, 0) * 55ms);
  }
  .booking.bk.bk-past { opacity: 0.82; }
  .booking.bk .msg { grid-column: 1 / -1; }

  .bk-badge { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--tint); border-radius: 14px; padding: 0.55rem 0.3rem; text-align: center; }
  .bk-badge small { font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .bk-badge b { font-size: 1.6rem; line-height: 1.1; }
  .bk-badge span { font-size: 0.72rem; color: var(--muted, #64748b); }

  .bk-main { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .bk-main strong { font-size: 1.04rem; }
  .bk-meta { color: var(--muted, #64748b); font-size: 0.88rem; font-variant-numeric: tabular-nums; }
  .bk-when { align-self: flex-start; font-size: 0.75rem; font-weight: 700; padding: 0.12rem 0.65rem; border-radius: 999px; background: #dcfce7; color: #166534; margin-top: 0.1rem; }

  /* Calendar + ticket buttons */
  .bk-tools { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.4rem; }
  .bk-tool { border: 1px solid var(--line, #e2e8f0); background: #fff; color: var(--ink, #111827); border-radius: 999px; padding: 0.3rem 0.8rem; font: inherit; font-size: 0.8rem; font-weight: 650; cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.15s; }
  .bk-tool:hover { background: var(--brand-soft, #eef2ff); color: var(--brand-dark, #4338ca); border-color: var(--brand, #4f46e5); transform: translateY(-1px); }
  .bk-tool:focus-visible { outline: 3px solid color-mix(in srgb, var(--brand, #4f46e5) 45%, transparent); outline-offset: 2px; }
  .bk-all { font-size: 0.82rem; padding: 0.4rem 0.95rem; }

  /* Ticket dialog */
  .tk { justify-items: center; text-align: center; }
  .tk-kicker { margin: 0; color: var(--brand-dark, #4338ca); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; }
  .tk-head { display: flex; align-items: center; gap: 0.9rem; text-align: left; justify-self: stretch; }
  .tk-icon { width: 52px; height: 52px; border-radius: 15px; background: var(--brand-soft, #eef2ff); display: grid; place-items: center; font-size: 1.7rem; flex: none; }
  .tk-head h2 { margin: 0; font-size: 1.25rem; }
  .tk-head p { margin: 0.1rem 0 0; font-size: 0.88rem; }
  .tk-qr { width: min(240px, 70vw); padding: 0.7rem; background: #fff; border: 1px solid var(--line, #e2e8f0); border-radius: 18px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); line-height: 0; }
  .tk-qr svg { display: block; width: 100%; height: auto; }
  .tk-code { margin: 0; color: var(--muted, #64748b); font-size: 0.9rem; }
  .tk-code b { color: var(--ink, #111827); font-size: 1.15rem; letter-spacing: 0.12em; font-variant-numeric: tabular-nums; }
  .tk-note { margin: 0; font-size: 0.82rem; }
  .tk .dialog-actions { justify-self: stretch; }

  @keyframes bk-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .booking.bk { animation: none; } .bk-tool { transition: none; } }
  @media (max-width: 640px) {
    .booking.bk { grid-template-columns: 70px 1fr; }
    .booking.bk .actions { grid-column: 1 / -1; }
  }
</style>