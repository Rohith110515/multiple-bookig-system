---
import Layout from '../layouts/Layout.astro';
import { TENANTS } from '../lib/tenants.js';
import { tarunam, formatTime } from '../lib/tarunam.js';

const user = Astro.locals.user;
const now = new Date();
const in7Days = new Date(now.getTime() + 7 * 24 * 3600 * 1000);

const studios = await Promise.all(
  Object.values(TENANTS).map(async (t) => {
    let classes = [];
    let upcoming = [];
    try {
      const [resR, resS] = await Promise.all([
        tarunam('GET', '/resources', { tenant: t }),
        tarunam('GET', '/schedules', {
          tenant: t,
          query: { from: now.toISOString(), to: in7Days.toISOString(), limit: 100 },
        }),
      ]);
      if (resR.status === 200 && Array.isArray(resR.data)) classes = resR.data;
      if (resS.status === 200 && Array.isArray(resS.data)) {
        upcoming = resS.data
          .filter((s) => Date.parse(s.start_time) > now.getTime() && s.seats_left > 0)
          .sort((a, b) => Date.parse(a.start_time) - Date.parse(b.start_time));
      }
    } catch {
      // Keep card usable even if a studio's API is temporarily unreachable
    }

    const nextSession = upcoming[0] ?? null;
    const totalOpenSeats = upcoming.reduce((sum, s) => sum + (s.seats_left ?? 0), 0);

    return {
      slug: t.slug,
      name: t.name,
      color: t.color || '#4f46e5',
      initial: (t.name || 'S').trim().charAt(0).toUpperCase(),
      classCount: classes.length,
      classNames: classes.map((c) => c.name),
      nextSession,
      totalOpenSeats,
    };
  })
);
---

<Layout title="All Studios">
  <section class="dir-hero">
    <div class="dir-hero-copy">
      <p class="dir-kicker">{user ? `WELCOME BACK, ${user.name.toUpperCase()}` : 'MULTI-STUDIO TIMETABLE'}</p>
      <h1>{user ? `Hi ${user.name}, where to today?` : 'Pick your space, claim your spot.'}</h1>
      <p class="dir-sub">
        Every studio runs its own schedule, capacity rules, and live seat availability. Jump into a timetable or catch the next open class.
      </p>
    </div>
    <div class="dir-pulse">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span><strong>{studios.length}</strong> active studios</span>
      <span class="pulse-sep">•</span>
      <span><strong>{studios.reduce((a, s) => a + s.totalOpenSeats, 0)}</strong> open seats this week</span>
    </div>
  </section>

  <section class="studio-grid" aria-label="Studios">
    {studios.map((st) => (
      <article class="studio-card" style={`--st-color: ${st.color};`}>
        <a class="studio-card-link" href={`/${st.slug}`}>
          <div class="studio-banner">
            <span class="studio-badge">{st.classCount} {st.classCount === 1 ? 'class' : 'classes'}</span>
            <div class="studio-avatar" aria-hidden="true">{st.initial}</div>
            <div class="studio-titles">
              <h2>{st.name}</h2>
              <span class="studio-slug">/{st.slug}</span>
            </div>
          </div>

          <div class="studio-body">
            {st.classNames.length > 0 && (
              <ul class="studio-tags" aria-label="Classes offered">
                {st.classNames.slice(0, 4).map((cname) => (
                  <li>{cname}</li>
                ))}
                {st.classNames.length > 4 && <li>+{st.classNames.length - 4} more</li>}
              </ul>
            )}

            <div class="studio-next">
              {st.nextSession ? (
                <>
                  <span class="next-pill">Next open</span>
                  <strong>{st.nextSession.resource_name}</strong>
                  <span class="muted">
                    {formatTime(st.nextSession.start_time)} · {st.nextSession.seats_left} {st.nextSession.seats_left === 1 ? 'seat' : 'seats'} left
                  </span>
                </>
              ) : (
                <span class="muted">Explore upcoming timetable &amp; rules</span>
              )}
            </div>

            <div class="studio-cta">
              <span>Open timetable</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      </article>
    ))}
  </section>
</Layout>

<style>
  .dir-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: 2.2rem 0 1.4rem;
  }
  .dir-kicker {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--brand);
  }
  .dir-hero h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }
  .dir-sub {
    margin: 0.45rem 0 0;
    max-width: 58ch;
    color: var(--muted);
    font-size: 0.98rem;
  }
  .dir-pulse {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    font-size: 0.86rem;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.18);
  }
  .pulse-sep {
    color: #cbd5e1;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.4rem;
    margin-top: 0.5rem;
  }
  .studio-card {
    border-radius: 22px;
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .studio-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--st-color) 45%, transparent);
    box-shadow: 0 18px 38px color-mix(in srgb, var(--st-color) 16%, transparent);
  }
  .studio-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .studio-banner {
    position: relative;
    overflow: hidden;
    padding: 1.5rem 1.5rem 1.35rem;
    color: #fff;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--st-color) 82%, #000),
      var(--st-color)
    );
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .studio-banner::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    right: -45px;
    top: -65px;
    background: rgba(255, 255, 255, 0.13);
    pointer-events: none;
  }
  .studio-badge {
    position: absolute;
    top: 0.95rem;
    right: 1rem;
    z-index: 2;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }
  .studio-avatar {
    position: relative;
    z-index: 1;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.35);
    display: grid;
    place-items: center;
    font-size: 1.45rem;
    font-weight: 850;
    flex: none;
  }
  .studio-titles {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .studio-titles h2 {
    margin: 0;
    color: #fff;
    font-size: 1.35rem;
  }
  .studio-slug {
    font-size: 0.84rem;
    opacity: 0.85;
  }

  .studio-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.3rem 1.5rem 1.4rem;
    flex: 1;
  }
  .studio-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .studio-tags li {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.24rem 0.65rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
  }
  .studio-next {
    margin-top: auto;
    padding: 0.85rem 0.95rem;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .next-pill {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--st-color);
  }
  .studio-next strong {
    font-size: 0.96rem;
  }
  .studio-next span:last-child {
    font-size: 0.82rem;
  }
  .studio-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 750;
    font-size: 0.94rem;
    color: var(--st-color);
    padding-top: 0.2rem;
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .studio-card:hover .cta-arrow {
    transform: translateX(4px);
  }
</style>