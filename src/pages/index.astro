---
import Layout from '../layouts/Layout.astro';
import { TENANTS } from '../lib/tenants.js';

const studios = Object.values(TENANTS);
---
<Layout title="Choose a studio">
  <section class="page-head">
    <h1>Choose a studio</h1>
    <p class="muted">Select a studio to view its timetable and book a session.</p>
  </section>
  <ul class="sessions">
    {studios.map((s) => (
      <li class="session" style="grid-template-columns: 1fr auto;">
        <div class="what">
          <strong>{s.name}</strong>
          <span class="seats">/{s.slug}</span>
        </div>
        <a class="btn btn-sm" href={`/${s.slug}`}>View schedule</a>
      </li>
    ))}
  </ul>
</Layout>